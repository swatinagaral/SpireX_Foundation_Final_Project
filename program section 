<section id="programs" className="m5-section">

  <div className="container m5-section-head">

    <div>
      <div className="section-kicker">
        Programs
      </div>

      <h2>
        Pathways for <span>growth.</span>
      </h2>
    </div>

    <p>
      Structured initiatives that combine knowledge,
      practice and collaboration.
    </p>

  </div>

  <div className="container m5-card-grid">

    {programs.map(
      ({ title, category, icon: Icon, text }) => (

        <article
          className="m5-program-card"
          key={title}
        >

          <Icon />

          <span>{category}</span>

          <h3>{title}</h3>

          <p>{text}</p>

          <button onClick={goContact}>
            Learn more
            <ArrowRight size={15} />
          </button>

        </article>

      )
    )}

  </div>

</section>